# Réglages non secrets du projet Flowzle (ECOSYSTEME.md §4 : versionné, lu par les skills).
# Aucun secret ici : les clients OAuth et clés d'API vont dans .env, jamais versionné.
#
# Les identifiants ci-dessous sont publics par nature : l'ID de conteneur GTM apparaît dans le
# code source de chaque page, l'ID de mesure GA4 dans la configuration du conteneur.

PROJET_SLUG=flowzle

# --- Search Console ------------------------------------------------------------------------
# Propriété de domaine créée le 10/11/2026, vérifiée par l'enregistrement TXT de l'apex posé
# par Terraform (website/infrastructure/dns-mail.tf, ressource apex_txt).
GSC_FLOWZLE_SITE=sc-domain:flowzle.com
GSC_FLOWZLE_SITEMAP_URL=https://flowzle.com/sitemap-index.xml

# --- Google Analytics 4 --------------------------------------------------------------------
# Propriété et flux web créés le 10/11/2026. Conservation des données portée à 14 mois,
# Google Signals laissé désactivé, « Interactions avec les formulaires » décoché dans la
# mesure améliorée (les événements de formulaire sont poussés explicitement dans le dataLayer).
GA4_FLOWZLE_MEASUREMENT_ID=G-MJPVV804Q8
GA4_FLOWZLE_STREAM_ID=16312286345
# basic : le bandeau refuse ad_storage, ad_user_data et ad_personalization en toutes circonstances.
GA4_FLOWZLE_CONSENT_MODE=basic

# --- Google Tag Manager --------------------------------------------------------------------
# Conteneur web créé et publié le 10/11/2026. Chargé par le site APRÈS consentement seulement
# (website/src/layouts/Layout.astro et src/components/BandeauCookies.astro) : le snippet
# d'installation de Google n'est pas utilisé, mais ces deux points d'injection poussent
# eux-mêmes { 'gtm.start', event: 'gtm.js' }, sans quoi aucune page vue n'a lieu.
GTM_FLOWZLE_CONTAINER_ID=GTM-WHKQRKRJ
# 34128000 s = 395 jours ≈ 13 mois, recommandation CNIL. Posé dans la balise GA4 - Configuration.
# La politique de confidentialité annonce cette durée : les deux changent ensemble.
GTM_FLOWZLE_COOKIE_EXPIRES=34128000

# Plan de marquage publié le 10/11/2026 : 4 balises, 3 déclencheurs, 2 variables.
#   contact_envoye  — conversion, après réponse de succès de l'API (pas au clic)
#   contact_erreur  — diagnostic, paramètre champs_en_erreur (noms de champs seulement)
#   clic_email      — conversion, clic sur un lien mailto:
# Le pot de miel du formulaire ne pousse rien : ces envois sont des robots.

# Ne pas confondre avec la « balise Google » GTM-K9X5GD6T, créée automatiquement avec la
# propriété GA4 : ce n'est pas un conteneur Tag Manager, elle n'est installée nulle part.

# --- À compléter ---------------------------------------------------------------------------
# Adresse du compte Google pro Flowzle, quand les branchements y seront refaits.
# GA4_FLOWZLE_COMPTE=
# GSC_FLOWZLE_COMPTE=
